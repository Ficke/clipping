{
  "name": "adamficke-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "rm -rf .astro && bun scripts/photos-media-dev.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "lambda:build": "bun build lambda/index.ts --target=node --outfile=dist-lambda/index.mjs --minify",
    "commerce:dev": "bun scripts/commerce-dev.mjs",
    "commerce:listen": "stripe listen --forward-to localhost:8787/api/stripe/webhook",
    "photos:push": "bun scripts/photos-push.mjs",
    "photos:build-media": "bun scripts/photos-build-media.mjs",
    "photos:build-media:local": "bun scripts/photos-media-dev.mjs",
    "photos:pull": "aws s3 sync s3://adamficke-com-originals/albums content/albums --exclude '*' --include '*.jpg' --include '*.jpeg' --include '*.png' --include '*.webp' --include '*.avif'"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-secrets-manager": "^3.1098.0",
    "@aws-sdk/client-sesv2": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@fontsource-variable/figtree": "^5.1.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.1.1",
    "exifr": "^7.1.3",
    "sharp": "^0.35.3",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright-core": "^1.61.1"
  }
}
