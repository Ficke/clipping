# Copy to .env.local (gitignored) for `bun run commerce:dev`.
#
# TEST keys only. Live keys never belong on a laptop — they live in AWS Secrets
# Manager, written straight from the Stripe dashboard to `aws secretsmanager
# put-secret-value`. commerce:dev refuses to start against an rk_live/sk_live
# key, and .githooks/pre-commit refuses to commit either kind.
#
#   Dashboard → Developers → API keys → Create restricted key (test mode)
#   Permissions: Checkout Sessions = write, everything else = none
STRIPE_API_KEY=rk_test_

# Printed by `bun run commerce:listen` when it starts. Changes each run unless
# you use a fixed listener.
STRIPE_WEBHOOK_SECRET=whsec_

# Optional. Any string; only has to stay stable across restarts for a download
# link minted before a restart to still work.
# DOWNLOAD_TOKEN_KEY=local-development-token-key
