---
import { render } from 'astro:content';
import StoryPhoto from '../../components/StoryPhoto.astro';
import Layout from '../../layouts/Layout.astro';
import { coverOf, formatDate, getAlbums, photosOf, slugOf } from '../../lib/albums';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album, index) => ({
    params: { slug: slugOf(album) },
    props: {
      album,
      newer: albums[index - 1] ?? null,
      older: albums[index + 1] ?? null,
    },
  }));
}

const { album, newer, older } = Astro.props;
const { Content } = await render(album);
const photos = await photosOf(album);
const opening = photos[0]!;
const remaining = photos.slice(1);
const hasNarrative = Boolean(album.body?.trim());
const cover = coverOf(album);
const dateIso = album.data.date.toISOString().slice(0, 10);
const coverAlt = album.data.alt[cover.file]
  ?? album.data.captions[cover.file]
  ?? `Cover photograph for ${album.data.title}`;

function altFor(index: number): string {
  const photo = photos[index]!;
  return photo.alt
    ?? photo.caption
    ?? `${album.data.title}, photograph ${index + 1} of ${photos.length}`;
}
---

<Layout
  title={`${album.data.title} — Adam Ficke`}
  description={album.data.description
    ?? `${album.data.title} — ${album.data.location}, ${formatDate(album.data.date)}. A photo story by Adam Ficke.`}
  ogImage={cover.variants.social.src}
  ogImageAlt={coverAlt}
  type="article"
  publishedTime={album.data.date}
  section="photography"
>
  <article class="story" data-story-id={album.data.storyId}>
    <header class="story-header rise">
      <p class="story-meta">
        <span>{album.data.location}</span>
        <span aria-hidden="true">·</span>
        <time datetime={dateIso}>{formatDate(album.data.date)}</time>
      </p>
      <h1>{album.data.title}</h1>
      {
        hasNarrative && (
          <div class="standfirst">
            <Content />
          </div>
        )
      }
    </header>

    <StoryPhoto
      photo={opening}
      alt={altFor(0)}
      index={0}
      total={photos.length}
      loading="eager"
      fetchpriority="high"
    />

    {
      remaining.length > 0 && (
        <div class="photos">
          {remaining.map((photo, index) => (
            <StoryPhoto
              photo={photo}
              alt={altFor(index + 1)}
              index={index + 1}
              total={photos.length}
            />
          ))}
        </div>
      )
    }

    <div class="discussion-mount" data-story-id={album.data.storyId}></div>

    {
      (newer || older) && (
        <nav class="story-nav" aria-label="More photo stories">
          {newer ? (
            <a class="story-nav-link newer" href={`/photography/${slugOf(newer)}/`} rel="prev">
              <span class="kicker">Newer story</span>
              <strong>{newer.data.title}</strong>
              <span>{newer.data.location}</span>
            </a>
          ) : <span />}
          {older && (
            <a class="story-nav-link older" href={`/photography/${slugOf(older)}/`} rel="next">
              <span class="kicker">Older story</span>
              <strong>{older.data.title}</strong>
              <span>{older.data.location}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <dialog id="lightbox" aria-label="Photograph viewer">
    <button id="lightbox-close" class="kicker">Close</button>
    {
      photos.length > 1 && (
        <>
          <button id="lightbox-prev" class="lightbox-nav" aria-label="Previous photograph">‹</button>
          <button id="lightbox-next" class="lightbox-nav" aria-label="Next photograph">›</button>
        </>
      )
    }
    <figure class="lightbox-figure">
      <img alt="" />
      <figcaption id="lightbox-caption" hidden></figcaption>
    </figure>
  </dialog>
</Layout>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector('img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption') as HTMLElement;
  const closeButton = document.getElementById('lightbox-close') as HTMLButtonElement;
  const prevButton = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
  const nextButton = document.getElementById('lightbox-next') as HTMLButtonElement | null;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
  let current = 0;
  let activeLink: HTMLAnchorElement | undefined;
  let touchStartX: number | undefined;

  function show(index: number) {
    current = (index + links.length) % links.length;
    const link = links[current]!;
    const captionText = link.dataset.caption?.trim() ?? '';

    img.src = link.href;
    img.alt = link.dataset.alt ?? '';
    caption.textContent = captionText;
    caption.hidden = captionText.length === 0;

    for (const neighbor of [current + 1, current - 1]) {
      new Image().src = links[(neighbor + links.length) % links.length]!.href;
    }
  }

  links.forEach((link, index) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      activeLink = link;
      show(index);
      dialog.showModal();
      closeButton.focus();
    });
  });

  prevButton?.addEventListener('click', () => show(current - 1));
  nextButton?.addEventListener('click', () => show(current + 1));
  closeButton.addEventListener('click', () => dialog.close());

  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  img.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'touch') touchStartX = event.clientX;
  });

  img.addEventListener('pointerup', (event) => {
    if (event.pointerType !== 'touch' || touchStartX === undefined) return;
    const distance = event.clientX - touchStartX;
    touchStartX = undefined;
    if (Math.abs(distance) < 50 || links.length < 2) return;
    show(distance > 0 ? current - 1 : current + 1);
  });

  dialog.addEventListener('close', () => {
    img.removeAttribute('src');
    img.alt = '';
    caption.textContent = '';
    caption.hidden = true;
    activeLink?.focus();
  });
</script>

<style>
  .story-header {
    margin: clamp(1.5rem, 5vw, 4.5rem) 0 clamp(2.4rem, 6vw, 4.2rem);
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .story-header h1 {
    max-width: 920px;
    margin-top: 0.45rem;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 0.98;
  }

  /* Editorial standfirst: sits under the title, on the same left axis, one
     step down from the headline in the display serif. */
  .standfirst {
    max-width: 46ch;
    margin-top: clamp(1.1rem, 2.5vw, 1.7rem);
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.4;
    color: color-mix(in srgb, var(--ink) 76%, var(--muted));
  }

  .standfirst :global(p + p),
  .standfirst :global(p + ul),
  .standfirst :global(p + ol),
  .standfirst :global(ul + p),
  .standfirst :global(ol + p) {
    margin-top: 0.7em;
  }

  .standfirst :global(h2),
  .standfirst :global(h3) {
    margin: 1.2em 0 0.5em;
  }

  .standfirst :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .standfirst :global(ul),
  .standfirst :global(ol) {
    padding-left: 1.25rem;
  }

  .standfirst :global(blockquote) {
    margin: 1.2em 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .photos {
    display: flex;
    flex-direction: column;
    gap: clamp(3.8rem, 9vw, 7rem);
    margin-top: clamp(3.8rem, 9vw, 7rem);
  }

  .discussion-mount:empty {
    display: none;
  }

  .story-nav {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 6vw, 4rem);
  }

  .story-nav-link {
    display: grid;
    align-content: start;
    gap: 0.15rem;
  }

  .story-nav-link strong {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-weight: 480;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .story-nav-link > span:last-child {
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .story-nav-link:hover strong,
  .story-nav-link:focus-visible strong {
    color: var(--accent);
  }

  .story-nav-link.older {
    text-align: right;
  }

  dialog {
    margin: auto;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    overflow: hidden;
    border: none;
    padding: 2.7rem 3.8rem 1.4rem;
    background: rgba(10, 9, 8, 0.98);
    color: #f7f4ee;
  }

  dialog::backdrop {
    background: rgba(10, 9, 8, 0.98);
  }

  .lightbox-figure {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  dialog img {
    max-width: 100%;
    max-height: calc(100vh - 6rem);
    width: auto;
    height: auto;
    object-fit: contain;
    touch-action: pan-y;
  }

  #lightbox-caption {
    width: min(100%, var(--measure));
    padding-top: 0.65rem;
    font-size: 0.8rem;
    line-height: 1.45;
    text-align: center;
    color: #bdb6aa;
  }

  #lightbox-close {
    position: fixed;
    z-index: 2;
    top: 0.45rem;
    right: 0.55rem;
    min-width: 44px;
    min-height: 44px;
    border: none;
    background: none;
    color: #f7f4ee;
    cursor: pointer;
  }

  .lightbox-nav {
    position: fixed;
    z-index: 2;
    top: 50%;
    min-width: 48px;
    min-height: 64px;
    transform: translateY(-50%);
    border: none;
    background: none;
    color: #f7f4ee;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .lightbox-nav:hover,
  .lightbox-nav:focus-visible {
    opacity: 1;
  }

  #lightbox-prev {
    left: 0.2rem;
  }

  #lightbox-next {
    right: 0.2rem;
  }

  @media (max-width: 620px) {
    .story-nav {
      grid-template-columns: 1fr;
    }

    .story-nav > span:empty {
      display: none;
    }

    .story-nav-link.older {
      text-align: left;
    }

    dialog {
      padding: 3.1rem 0.8rem 1rem;
    }

    dialog img {
      max-height: calc(100vh - 7rem);
    }

    .lightbox-nav {
      top: auto;
      bottom: 0.35rem;
      transform: none;
    }
  }
</style>
