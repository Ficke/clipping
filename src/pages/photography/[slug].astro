---
import { render } from 'astro:content';
import Lightbox from '../../components/Lightbox.astro';
import StoryPhoto from '../../components/StoryPhoto.astro';
import Layout from '../../layouts/Layout.astro';
import { coverAltOf, coverOf, formatDate, getAlbums, photosOf, publishedAt, slugOf } from '../../lib/albums';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album, index) => ({
    params: { slug: slugOf(album) },
    props: {
      album,
      newer: albums[index - 1] ?? null,
      older: albums[index + 1] ?? null,
    },
  }));
}

const { album, newer, older } = Astro.props;
const { Content } = await render(album);
const photos = await photosOf(album);
const opening = photos[0]!;
const remaining = photos.slice(1);
const hasNarrative = Boolean(album.body?.trim());
const cover = coverOf(album);
const dateIso = album.data.date.toISOString().slice(0, 10);
const coverAlt = coverAltOf(album);

function altFor(index: number): string {
  const photo = photos[index]!;
  return photo.alt
    ?? photo.caption
    ?? `${album.data.title}, photograph ${index + 1} of ${photos.length}`;
}
---

<Layout
  title={`${album.data.title} — Adam Ficke`}
  description={album.data.description
    ?? `${album.data.title} — ${album.data.location}, ${formatDate(album.data.date)}. A photo story by Adam Ficke.`}
  ogImage={cover.variants.social.src}
  ogImageAlt={coverAlt}
  type="article"
  publishedTime={publishedAt(album)}
  section="photography"
>
  <article class="story" data-story-id={album.data.storyId}>
    <header class="story-header rise">
      <p class="story-meta">
        <span>{album.data.location}</span>
        <span aria-hidden="true">·</span>
        <time datetime={dateIso}>{formatDate(album.data.date)}</time>
      </p>
      <h1>{album.data.title}</h1>
    </header>

    <StoryPhoto
      photo={opening}
      alt={altFor(0)}
      index={0}
      total={photos.length}
      loading="eager"
      fetchpriority="high"
    />

    {
      hasNarrative && (
        <section class="narrative rise" aria-label="Trip notes">
          <Content />
        </section>
      )
    }

    {
      remaining.length > 0 && (
        <div class="photos">
          {remaining.map((photo, index) => (
            <StoryPhoto
              photo={photo}
              alt={altFor(index + 1)}
              index={index + 1}
              total={photos.length}
            />
          ))}
        </div>
      )
    }

    <div class="discussion-mount" data-story-id={album.data.storyId}></div>

    {
      (newer || older) && (
        <nav class="story-nav" aria-label="More photo stories">
          {newer ? (
            <a class="story-nav-link newer" href={`/photography/${slugOf(newer)}/`} rel="prev">
              <span class="kicker">Newer story</span>
              <strong>{newer.data.title}</strong>
              <span>{newer.data.location}</span>
            </a>
          ) : <span />}
          {older && (
            <a class="story-nav-link older" href={`/photography/${slugOf(older)}/`} rel="next">
              <span class="kicker">Older story</span>
              <strong>{older.data.title}</strong>
              <span>{older.data.location}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <Lightbox photoCount={photos.length} />
</Layout>

<style>
  .story-header {
    margin: clamp(1.5rem, 5vw, 4.5rem) 0 clamp(2.4rem, 6vw, 4.2rem);
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .story-header h1 {
    max-width: 920px;
    margin-top: 0.45rem;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 0.98;
  }

  .narrative {
    max-width: var(--measure);
    margin: clamp(3rem, 8vw, 6rem) auto;
    font-size: clamp(1rem, 1.4vw, 1.08rem);
    color: color-mix(in srgb, var(--ink) 92%, var(--muted));
  }

  .narrative::before {
    content: '';
    display: block;
    width: 3rem;
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .narrative :global(p + p),
  .narrative :global(p + ul),
  .narrative :global(p + ol),
  .narrative :global(ul + p),
  .narrative :global(ol + p) {
    margin-top: 1em;
  }

  .narrative :global(h2),
  .narrative :global(h3) {
    margin: 1.6em 0 0.65em;
  }

  .narrative :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .narrative :global(ul),
  .narrative :global(ol) {
    padding-left: 1.25rem;
  }

  .narrative :global(blockquote) {
    margin: 1.4em 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .photos {
    display: flex;
    flex-direction: column;
    gap: clamp(3.8rem, 9vw, 7rem);
    margin-top: clamp(3.8rem, 9vw, 7rem);
  }

  .discussion-mount:empty {
    display: none;
  }

  .story-nav {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 6vw, 4rem);
  }

  .story-nav-link {
    display: grid;
    align-content: start;
    gap: 0.15rem;
  }

  .story-nav-link strong {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-weight: 480;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .story-nav-link > span:last-child {
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .story-nav-link:hover strong,
  .story-nav-link:focus-visible strong {
    color: var(--accent);
  }

  .story-nav-link.older {
    text-align: right;
  }

  @media (max-width: 620px) {
    .story-nav {
      grid-template-columns: 1fr;
    }

    .story-nav > span:empty {
      display: none;
    }

    .story-nav-link.older {
      text-align: left;
    }
  }
</style>
