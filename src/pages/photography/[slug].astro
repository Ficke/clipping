---
import { render } from 'astro:content';
import Lightbox from '../../components/Lightbox.astro';
import StoryPhoto from '../../components/StoryPhoto.astro';
import Layout from '../../layouts/Layout.astro';
import { coverAltOf, coverOf, formatDate, getAlbums, photosOf, publishedAt, slugOf } from '../../lib/albums';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album, index) => ({
    params: { slug: slugOf(album) },
    props: {
      album,
      newer: albums[index - 1] ?? null,
      older: albums[index + 1] ?? null,
    },
  }));
}

const { album, newer, older } = Astro.props;
const { Content } = await render(album);
const photos = await photosOf(album);
const opening = photos[0]!;
const remaining = photos.slice(1);
/* Standfirst is the frontmatter description — the same crisp line that serves as
   the meta/OG description. Deliberately not the generated meta fallback, which
   would read as boilerplate on the page. */
const standfirst = album.data.description?.trim();
/* Long-form prose is the markdown body, rendered below the photographs. */
const hasNarrative = Boolean(album.body?.trim());
const cover = coverOf(album);
const dateIso = album.data.date.toISOString().slice(0, 10);
const coverAlt = coverAltOf(album);

function altFor(index: number): string {
  const photo = photos[index]!;
  return photo.alt
    ?? photo.caption
    ?? `${album.data.title}, photograph ${index + 1} of ${photos.length}`;
}
---

<Layout
  title={`${album.data.title} — Adam Ficke`}
  description={album.data.description
    ?? `${album.data.title} — ${album.data.location}, ${formatDate(album.data.date)}. A photo story by Adam Ficke.`}
  ogImage={cover.variants.social.src}
  ogImageAlt={coverAlt}
  type="article"
  publishedTime={publishedAt(album)}
  section="photography"
>
  <article class="story" data-story-id={album.data.storyId}>
    <header class="story-header rise">
      <p class="story-meta">
        <span>{album.data.location}</span>
        <span aria-hidden="true">·</span>
        <time datetime={dateIso}>{formatDate(album.data.date)}</time>
      </p>
      <h1>{album.data.title}</h1>
      {standfirst && <p class="standfirst">{standfirst}</p>}
      {
        hasNarrative && (
          <div class="prose">
            <Content />
          </div>
        )
      }
    </header>

    <StoryPhoto
      photo={opening}
      alt={altFor(0)}
      index={0}
      total={photos.length}
      loading="eager"
      fetchpriority="high"
    />

    {
      remaining.length > 0 && (
        <div class="photos">
          {remaining.map((photo, index) => (
            <StoryPhoto
              photo={photo}
              alt={altFor(index + 1)}
              index={index + 1}
              total={photos.length}
            />
          ))}
        </div>
      )
    }

    <div class="discussion-mount" data-story-id={album.data.storyId}></div>

    {
      (newer || older) && (
        <nav class="story-nav" aria-label="More photo stories">
          {newer ? (
            <a class="story-nav-link newer" href={`/photography/${slugOf(newer)}/`} rel="prev">
              <span class="kicker">Newer story</span>
              <strong>{newer.data.title}</strong>
              <span>{newer.data.location}</span>
            </a>
          ) : <span />}
          {older && (
            <a class="story-nav-link older" href={`/photography/${slugOf(older)}/`} rel="next">
              <span class="kicker">Older story</span>
              <strong>{older.data.title}</strong>
              <span>{older.data.location}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <Lightbox photoCount={photos.length} />
</Layout>

<style>
  .story-header {
    margin: clamp(1.5rem, 5vw, 4.5rem) 0 clamp(2.4rem, 6vw, 4.2rem);
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .story-header h1 {
    max-width: 920px;
    margin-top: 0.45rem;
    font-size: clamp(2.2rem, 5vw, 3.9rem);
    line-height: 1.02;
  }

  /* Editorial standfirst: the frontmatter description, sitting under the title
     on the same left axis, one step down from the headline in the serif. */
  .standfirst {
    /* rem, not ch: ch resolves against each element's own font, so a ch measure
       here would render narrower than the sans-set .prose directly below it */
    max-width: 34rem;
    margin-top: clamp(1.1rem, 2.5vw, 1.7rem);
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    /* text-grade optical size + lighter weight keep this from reading as a
       second headline, since it shares the display family */
    font-variation-settings: 'opsz' 16;
    font-weight: 400;
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 76%, var(--muted));
  }

  /* Long-form prose: the markdown body, directly under the standfirst. Full
     measure and body-grade type, so it reads as an essay rather than an
     extended dek. */
  .prose {
    max-width: 34rem;
    margin-top: clamp(1.2rem, 2.5vw, 1.8rem);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .prose :global(p + p),
  .prose :global(p + ul),
  .prose :global(p + ol),
  .prose :global(ul + p),
  .prose :global(ol + p) {
    margin-top: 1.1em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 1.8em 0 0.6em;
    font-size: 1.35rem;
    /* the global h2/h3 rule sets a display-grade opsz; step it down to match
       the smaller size these render at inside prose */
    font-variation-settings: 'opsz' 24;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }

  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .photos {
    display: flex;
    flex-direction: column;
    gap: clamp(3.8rem, 9vw, 7rem);
    margin-top: clamp(3.8rem, 9vw, 7rem);
  }

  .discussion-mount:empty {
    display: none;
  }

  .story-nav {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 6vw, 4rem);
  }

  .story-nav-link {
    display: grid;
    align-content: start;
    gap: 0.15rem;
  }

  .story-nav-link strong {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-variation-settings: 'opsz' 28;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-weight: 500;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .story-nav-link > span:last-child {
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .story-nav-link:hover strong,
  .story-nav-link:focus-visible strong {
    color: var(--accent);
  }

  .story-nav-link.older {
    text-align: right;
  }

  @media (max-width: 620px) {
    .story-nav {
      grid-template-columns: 1fr;
    }

    .story-nav > span:empty {
      display: none;
    }

    .story-nav-link.older {
      text-align: left;
    }
  }
</style>
