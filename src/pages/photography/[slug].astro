---
import { render } from 'astro:content';
import PhotoPicture from '../../components/PhotoPicture.astro';
import Layout from '../../layouts/Layout.astro';
import { coverOf, formatDate, getAlbums, photosOf, slugOf } from '../../lib/albums';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { slug: slugOf(album) }, props: { album } }));
}

const { album } = Astro.props;
const { Content } = await render(album);
const photos = await photosOf(album);
const hasIntro = album.body && album.body.trim().length > 0;

const cover = coverOf(album);
---

<Layout
  title={`${album.data.title} — Adam Ficke`}
  description={album.data.description ?? `${album.data.title}, ${formatDate(album.data.date)}. Photographs by Adam Ficke.`}
  ogImage={cover.variants.social.src}
>
  <article>
    <header class="album-header rise">
      <p class="kicker">
        <a href="/">Photography</a>
        <span aria-hidden="true"> / </span>
        {formatDate(album.data.date)}
      </p>
      <h1>{album.data.title}</h1>
      {
        hasIntro && (
          <div class="intro">
            <Content />
          </div>
        )
      }
    </header>

    <div class="photos">
      {
        photos.map((photo, i) => (
          <figure class="rise" style={`animation-delay: ${Math.min(120 + i * 60, 420)}ms`}>
            <a href={photo.image.variants.lightbox.src} class="zoom" data-lightbox aria-label={`View ${photo.file} fullsize`}>
              <PhotoPicture
                photo={photo.image}
                alt={photo.caption ?? `${album.data.title}, photograph ${i + 1}`}
                sizes="(min-width: 1200px) 1040px, 94vw"
                loading={i < 2 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </a>
            {(photo.caption || photo.exif) && (
              <figcaption>
                {photo.caption && <span class="caption">{photo.caption}</span>}
                {photo.exif && <span class="exif">{photo.exif}</span>}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </article>

  <dialog id="lightbox" aria-label="Fullsize photograph" tabindex="-1">
    <button id="lightbox-close" class="kicker">Close</button>
    <button id="lightbox-prev" class="lightbox-nav" aria-label="Previous photograph">‹</button>
    <img alt="" />
    <button id="lightbox-next" class="lightbox-nav" aria-label="Next photograph">›</button>
  </dialog>
</Layout>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector('img')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
  let current = 0;

  function show(i: number) {
    current = (i + links.length) % links.length;
    img.src = links[current]!.href;
    // warm the neighbors so arrowing through feels instant
    for (const n of [current + 1, current - 1]) {
      new Image().src = links[(n + links.length) % links.length]!.href;
    }
  }

  links.forEach((a, i) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
      dialog.focus();
    });
  });
  document.getElementById('lightbox-prev')!.addEventListener('click', () => show(current - 1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  img.addEventListener('click', () => dialog.close());
  document.getElementById('lightbox-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    img.removeAttribute('src');
  });
</script>

<style>
  .album-header {
    margin: clamp(1rem, 4vw, 3rem) 0 clamp(2.2rem, 5vw, 3.4rem);
  }

  .album-header h1 {
    font-size: clamp(2rem, 6vw, 3.4rem);
    margin: 0.3rem 0 0;
  }

  .album-header .kicker a:hover {
    color: var(--accent);
  }

  .intro {
    max-width: var(--measure);
    margin-top: 1.3rem;
    color: color-mix(in srgb, var(--ink) 88%, var(--muted));
  }

  .intro :global(p + p) {
    margin-top: 0.8em;
  }

  .photos {
    display: flex;
    flex-direction: column;
    gap: clamp(2.6rem, 6vw, 4rem);
  }

  .zoom {
    display: block;
    cursor: zoom-in;
  }

  .photos img {
    width: 100%;
    border-radius: 2px;
  }

  figcaption {
    margin-top: 0.55rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  figcaption .exif {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  dialog {
    /* the global `* { margin: 0 }` reset kills the UA's centering margin */
    margin: auto;
    outline: none;
    border: none;
    padding: 0;
    background: transparent;
    max-width: 96vw;
    max-height: 96vh;
  }

  dialog::backdrop {
    background: rgba(10, 9, 8, 0.92);
  }

  dialog img {
    max-width: 96vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    cursor: zoom-out;
  }

  #lightbox-close {
    position: fixed;
    top: 0.6rem;
    right: 0.8rem;
    background: none;
    border: none;
    color: #f7f4ee;
    cursor: pointer;
    padding: 0.5rem;
  }

  .lightbox-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #f7f4ee;
    font-size: 2.4rem;
    line-height: 1;
    padding: 1.2rem 0.9rem;
    cursor: pointer;
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .lightbox-nav:hover,
  .lightbox-nav:focus-visible {
    opacity: 1;
  }

  #lightbox-prev {
    left: 0.4rem;
  }

  #lightbox-next {
    right: 0.4rem;
  }
</style>
