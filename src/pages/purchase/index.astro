---
import Layout from '../../layouts/Layout.astro';

/*
 * Where Stripe returns a buyer. The page itself is static; the entitlement is
 * fetched from /api/fulfill with the session id Stripe puts in the URL, which is
 * same-origin and so allowed by `connect-src 'self'` without a CSP change.
 *
 * This is the immediate fulfillment path. Stripe sends the payment receipt; a
 * buyer who loses this page can reply to that receipt for a manually reissued
 * download link.
 */
---

<Layout
  title="Your download — Adam Ficke"
  description="Your full-resolution download."
  noindex
>
  <!-- The outcome arrives after load, so announce it rather than letting a
       screen reader sit on "Preparing your download…". -->
  <section class="purchase rise" aria-live="polite" aria-busy="true" data-region>
    <p class="kicker">Thank you</p>
    <h1 data-heading>Preparing your download…</h1>

    <div class="state" data-state="loading">
      <p>One moment while I confirm the payment.</p>
    </div>

    <div class="state" data-state="paid" hidden>
      <article class="download-card">
        <figure class="preview" data-preview-wrap hidden>
          <img data-preview alt="" />
        </figure>
        <div class="details">
          <p class="kicker">Purchase confirmed</p>
          <h2 data-summary></h2>
          <p class="product">Full-resolution photograph, personal-use license</p>
          <a class="download" data-download href="#" download>
            <span>Download photograph</span>
            <span aria-hidden="true">↓</span>
          </a>
          <p class="expiry">
            <span data-expiry></span> Reply to your Stripe receipt if you need a
            new link.
          </p>
        </div>
      </article>

      <p><a class="back" href="/store/">Return to the store</a></p>
    </div>

    <div class="state" data-state="pending" hidden>
      <p>
        Your payment has not completed. Return to Checkout or reply to your
        Stripe receipt if you need help.
      </p>
    </div>

    <div class="state" data-state="error" hidden>
      <p data-error>Something went wrong.</p>
      <p class="note">
        If you were charged, the file is yours — reply to your Stripe receipt and
        I will send it straight over.
      </p>
    </div>
  </section>
</Layout>

<script>
  const heading = document.querySelector<HTMLElement>('[data-heading]')!;
  const states = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-state]')].map((el) => [el.dataset.state!, el]),
  );

  function show(name: string) {
    for (const [key, el] of states) el.hidden = key !== name;
    document.querySelector<HTMLElement>('[data-region]')!.setAttribute('aria-busy', 'false');
  }

  function fail(message: string) {
    heading.textContent = 'That did not work';
    document.querySelector<HTMLElement>('[data-error]')!.textContent = message;
    show('error');
  }

  const sessionId = new URLSearchParams(location.search).get('session_id');
  if (!sessionId) {
    fail('This page needs the link from your checkout to find your order.');
  } else {
    try {
      const response = await fetch(`/api/fulfill?session_id=${encodeURIComponent(sessionId)}`);
      const body = await response.json();

      if (response.status === 202 || body.status === 'pending') {
        heading.textContent = 'Payment is clearing';
        show('pending');
      } else if (!response.ok) {
        fail(body.error ?? 'Your order could not be confirmed.');
      } else {
        /*
         * Never assign a URL straight from a response to href — a `javascript:`
         * value there would execute on click. Check the scheme rather than the
         * origin: the Lambda builds this from SITE_URL, which is the canonical
         * host and so not always the host being browsed, and a buyer losing
         * their download to a hostname mismatch would be the worse failure.
         */
        const target = new URL(body.downloadUrl, location.origin);
        if (target.protocol !== 'https:' && target.protocol !== 'http:') {
          throw new Error(`refusing a ${target.protocol} download URL`);
        }

        const link = document.querySelector<HTMLAnchorElement>('[data-download]')!;
        link.href = target.href;
        heading.textContent = 'Your photograph is ready';
        document.querySelector<HTMLElement>('[data-summary]')!.textContent =
          body.albumTitle;
        if (body.previewSrc) {
          const preview = document.querySelector<HTMLImageElement>('[data-preview]')!;
          preview.src = body.previewSrc;
          preview.alt = body.label ?? `Purchased photograph from ${body.albumTitle}`;
          document.querySelector<HTMLElement>('[data-preview-wrap]')!.hidden = false;
        }
        document.querySelector<HTMLElement>('[data-expiry]')!.textContent =
          `Link expires ${new Date(body.expiresAt * 1000).toLocaleDateString(undefined, { dateStyle: 'long' })}.`;
        show('paid');
      }
    } catch {
      fail('I could not reach the store to confirm your order.');
    }
  }
</script>

<style>
  .purchase {
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .purchase h1 {
    max-width: none;
    font-size: clamp(2.35rem, 4vw, 3.6rem);
    margin: 0.3rem 0 1.2rem;
  }

  .state {
    display: grid;
    gap: 1rem;
  }

  .state[data-state='loading'],
  .state[data-state='pending'],
  .state[data-state='error'] {
    max-width: var(--measure);
  }

  /* An author `display` beats the UA stylesheet's [hidden] { display: none },
     so without this every state renders at once. */
  .state[hidden] {
    display: none;
  }

  .download-card {
    width: min(100%, 68rem);
    margin-top: 0.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 3px;
  }

  .preview {
    min-height: 18rem;
    background: color-mix(in srgb, var(--ink) 5%, var(--paper));
  }

  .preview[hidden] {
    display: none;
  }

  .preview img {
    width: 100%;
    height: 100%;
    min-height: 18rem;
    max-height: 28rem;
    object-fit: cover;
  }

  .details {
    padding: clamp(1.4rem, 3vw, 2.1rem);
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .details h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
  }

  .product {
    margin-top: 0.65rem;
    font-size: 0.84rem;
    color: var(--muted);
  }

  .download {
    margin-top: auto;
    padding: 0.9rem 1rem;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    border-radius: 2px;
    transition: background 0.2s ease;
  }

  .download:hover,
  .download:focus-visible {
    background: var(--accent);
  }

  .expiry {
    margin-top: 0.7rem;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .back {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .back:hover,
  .back:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .download-card {
      grid-template-columns: 1fr;
    }

    .preview,
    .preview img {
      min-height: 0;
      max-height: none;
      aspect-ratio: 4 / 3;
    }

    .preview img {
      object-fit: contain;
    }

    .download {
      margin-top: 1.8rem;
    }
  }
</style>
