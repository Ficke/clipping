---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About — Adam Ficke"
  description="Adam Ficke is a photographer based in San Francisco."
  section="about"
>
  <section class="about rise">
    <header class="page-heading">
      <h1>About</h1>
    </header>
    <div class="about-copy">
      <p>Photographs from trips and around town. Based in SF.</p>
    </div>
    <p class="about-links">
      <a href="https://www.instagram.com/youngficke/" rel="me">@youngficke on Instagram</a>
    </p>
  </section>
</Layout>

<style>
  .about {
    max-width: var(--measure);
  }

  .about-copy {
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }

  .about-links {
    margin-top: 1.5rem;
  }

  .about-links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
