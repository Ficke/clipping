---
import PhotoPicture from '../components/PhotoPicture.astro';
import Layout from '../layouts/Layout.astro';
import { coverAltOf, coverOf, formatDate, getAlbums } from '../lib/albums';

const albums = await getAlbums();
const latest = albums[0];
const latestCover = latest ? coverOf(latest) : undefined;
const latestCoverAlt = latest ? coverAltOf(latest) : undefined;
---

<Layout
  title="Adam Ficke — Photography"
  description="Photographs by Adam Ficke."
  ogImage={latestCover?.variants.social.src}
  ogImageAlt={latestCoverAlt}
  section="photography"
>
  <header class="page-heading rise">
    <h1>Photography</h1>
  </header>

  <ol class="albums" aria-label="Photo stories, newest first">
    {
      albums.map((album, i) => {
        const cover = coverOf(album);
        return (
          <li class="album rise" style={`animation-delay: ${Math.min(i * 90, 360)}ms`}>
            <a href={`/photography/${album.data.storyId}/`}>
              <PhotoPicture
                photo={cover}
                alt={coverAltOf(album)}
                sizes="(min-width: 1200px) 1040px, 94vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
              <h2>{album.data.title}</h2>
              <p class="story-meta">
                <span>{album.data.location}</span>
                <span aria-hidden="true">·</span>
                <time datetime={album.data.date.toISOString().slice(0, 10)}>
                  {formatDate(album.data.date)}
                </time>
              </p>
            </a>
          </li>
        );
      })
    }
  </ol>
</Layout>

<style>
  .albums {
    list-style: none;
    padding: 0;
    margin: clamp(1.5rem, 4vw, 3rem) 0 0;
    display: flex;
    flex-direction: column;
    gap: clamp(4.2rem, 10vw, 8rem);
  }

  .album a {
    display: block;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .album h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    margin: 1.1rem 0 0.3rem;
    transition: color 0.25s ease;
  }

  .album a:hover h2,
  .album a:focus-visible h2 {
    color: var(--accent);
  }

  .album img {
    width: 100%;
    border-radius: 2px;
  }
</style>
