---
import PhotoPicture from '../components/PhotoPicture.astro';
import Layout from '../layouts/Layout.astro';
import { coverOf, formatDate, getAlbums, slugOf } from '../lib/albums';

const albums = await getAlbums();
const latest = albums[0];
const latestCover = latest ? coverOf(latest) : undefined;
const latestCoverAlt = latest && latestCover
  ? latest.data.alt[latestCover.file]
    ?? latest.data.captions[latestCover.file]
    ?? `Cover photograph for ${latest.data.title}`
  : undefined;
---

<Layout
  title="Adam Ficke — Photography"
  description="Photographs from trips and time outdoors by Adam Ficke."
  ogImage={latestCover?.variants.social.src}
  ogImageAlt={latestCoverAlt}
  section="photography"
>
  <header class="index-intro rise">
    <p class="kicker">Photography</p>
    <h1>Photographs from trips and time outdoors.</h1>
  </header>

  <ol class="albums" aria-label="Photo stories, newest first">
    {
      albums.map((album, i) => {
        const cover = coverOf(album);
        return (
          <li class="album rise" style={`animation-delay: ${Math.min(i * 90, 360)}ms`}>
            <a href={`/photography/${slugOf(album)}/`}>
              <p class="story-meta">
                <span>{album.data.location}</span>
                <span aria-hidden="true">·</span>
                <time datetime={album.data.date.toISOString().slice(0, 10)}>
                  {formatDate(album.data.date)}
                </time>
              </p>
              <h2>{album.data.title}</h2>
              <PhotoPicture
                photo={cover}
                alt={album.data.alt[cover.file]
                  ?? album.data.captions[cover.file]
                  ?? `Cover photograph for ${album.data.title}`}
                sizes="(min-width: 1200px) 1040px, 94vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </a>
          </li>
        );
      })
    }
  </ol>
</Layout>

<style>
  .index-intro {
    margin: clamp(1.5rem, 5vw, 4.5rem) 0 clamp(3.6rem, 8vw, 6.5rem);
    max-width: 820px;
  }

  .index-intro h1 {
    margin-top: 0.45rem;
    font-size: clamp(2.4rem, 7vw, 5.2rem);
    line-height: 0.98;
  }

  .albums {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(4.2rem, 10vw, 8rem);
  }

  .album a {
    display: block;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .album h2 {
    font-size: clamp(1.9rem, 4.8vw, 3rem);
    margin: 0.35rem 0 1.1rem;
    transition: color 0.25s ease;
  }

  .album a:hover h2,
  .album a:focus-visible h2 {
    color: var(--accent);
  }

  .album img {
    width: 100%;
    border-radius: 2px;
  }
</style>
