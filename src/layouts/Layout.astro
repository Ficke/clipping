---
import '@fontsource-variable/figtree/index.css';
/* The default font package omits the optical-size axis. */
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  section?: 'photography' | 'store' | 'about' | 'license';
  /** Keep a page out of search results. Also exclude it from the sitemap. */
  noindex?: boolean;
}

const {
  title,
  description = 'Photo stories by Adam Ficke.',
  ogImage,
  ogImageAlt,
  type = 'website',
  publishedTime,
  section,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const photographyCurrent = section === 'photography'
  ? (Astro.url.pathname === '/' ? 'page' : 'true')
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="Adam Ficke — Photography" href="/rss.xml" />
    <script src="../scripts/analytics.ts"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">Adam Ficke</a>
      <nav class="kicker" aria-label="Primary">
        <a href="/" aria-current={photographyCurrent}>Photography</a>
        <a href="/store/" aria-current={section === 'store' ? 'page' : undefined}>Store</a>
        <a href="/about/" aria-current={section === 'about' ? 'page' : undefined}>About</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Adam Ficke</span>
      <nav aria-label="Footer">
        <a href="https://www.instagram.com/youngficke/" rel="me">Instagram</a>
        <a href="/rss.xml">RSS</a>
        <a href="/license/" aria-current={section === 'license' ? 'page' : undefined}>License</a>
      </nav>
    </footer>
  </body>
</html>
