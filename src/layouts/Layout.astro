---
import '@fontsource-variable/figtree';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Landscape photography by Adam Ficke.',
  ogImage,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="Adam Ficke — Photography" href="/rss.xml" />
    <script src="../scripts/analytics.ts"></script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">Adam Ficke</a>
      <nav class="kicker">
        <a href="/">Photography</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Adam Ficke</span>
      <span>All photographs are my own</span>
    </footer>
  </body>
</html>
