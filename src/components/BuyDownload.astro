---
import { formatPrice } from '../lib/downloads';
import type { SellablePhoto } from '../lib/catalog';

interface Props {
  offers: SellablePhoto[];
}

const { offers } = Astro.props;
/* Several tiers need naming to tell the buttons apart; one does not. */
const named = offers.length > 1;
---

{
  /* A link, not a form: the CSP sets form-action 'none', and the redirect to
     Stripe happens server-side in /api/checkout. */
  offers.map((offer) => (
    <a class="buy" href={offer.href} rel="nofollow">
      {named ? `${offer.tier.summary} — ` : 'Buy — '}
      {formatPrice(offer.tier.priceCents)}
    </a>
  ))
}

<style>
  .buy {
    display: inline-block;
    padding: 0.7rem 1.15rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    border-radius: 2px;
    transition: background 0.2s ease;
  }

  .buy:hover,
  .buy:focus-visible {
    background: var(--accent);
  }
</style>
