---
/**
 * Full-screen photo viewer. Drop one per page; it drives every
 * `a[data-lightbox]` on that page (see StoryPhoto.astro) and is deep-linkable
 * with a page-supplied stable fragment or the `#photo-N` fallback. Behavior
 * lives in scripts/lightbox.ts.
 */
interface Props {
  photoCount: number;
  single?: boolean;
}

const { photoCount, single = false } = Astro.props;
---

<dialog id="lightbox" aria-label="Photograph viewer" data-single={single || undefined}>
  <button id="lightbox-close" class="kicker">Close</button>
  {
    !single && photoCount > 1 && (
      <>
        <button id="lightbox-prev" class="lightbox-nav" aria-label="Previous photograph">‹</button>
        <button id="lightbox-next" class="lightbox-nav" aria-label="Next photograph">›</button>
      </>
    )
  }
  <figure class="lightbox-figure">
    <img alt="" decoding="async" />
    <figcaption id="lightbox-caption" hidden></figcaption>
  </figure>
</dialog>

<script src="../scripts/lightbox.ts"></script>

<style>
  dialog {
    margin: auto;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    overflow: hidden;
    border: none;
    padding: 0;
    background: rgba(10, 9, 8, 0.98);
    color: #f7f4ee;
  }

  dialog::backdrop {
    background: rgba(10, 9, 8, 0.98);
  }

  .lightbox-figure {
    height: 100%;
    /* The photo row takes whatever the caption does not, and the image
       sizes itself inside it — so the img box hugs the actual pixels and
       clicks on the surrounding black land on the figure (close target). */
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    place-items: center;
    /* Chrome scales with the viewport so short landscape phones spend
       almost all of their height on the photograph. */
    padding: clamp(0.4rem, 2.4vh, 2.7rem) clamp(3rem, 4vw, 3.8rem)
      clamp(0.4rem, 1.6vh, 1.4rem);
  }

  dialog img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    touch-action: pan-y;
  }

  #lightbox-caption {
    width: min(100%, var(--measure));
    padding-top: 0.65rem;
    font-size: 0.8rem;
    line-height: 1.45;
    text-align: center;
    color: #bdb6aa;
  }

  #lightbox-close {
    position: fixed;
    z-index: 2;
    top: 0.45rem;
    right: 0.55rem;
    min-width: 44px;
    min-height: 44px;
    border: none;
    background: none;
    color: #f7f4ee;
    text-shadow: 0 1px 6px rgba(10, 9, 8, 0.9);
    cursor: pointer;
  }

  .lightbox-nav {
    position: fixed;
    z-index: 2;
    top: 50%;
    min-width: 48px;
    min-height: 64px;
    transform: translateY(-50%);
    border: none;
    background: none;
    color: #f7f4ee;
    font-size: 2.5rem;
    line-height: 1;
    text-shadow: 0 1px 6px rgba(10, 9, 8, 0.9);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .lightbox-nav:hover,
  .lightbox-nav:focus-visible {
    opacity: 1;
  }

  #lightbox-prev {
    left: 0.2rem;
  }

  #lightbox-next {
    right: 0.2rem;
  }

  @media (max-width: 620px) {
    .lightbox-figure {
      padding: clamp(0.4rem, 2.4vh, 2.9rem) 0.6rem 3.2rem;
    }

    .lightbox-nav {
      top: auto;
      bottom: 0.35rem;
      min-height: 48px;
      transform: none;
    }
  }
</style>
