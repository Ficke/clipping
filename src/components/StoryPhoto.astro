---
import type { AlbumPhoto } from '../lib/albums';
import { photoIdFor } from '../lib/downloads';
import { lightboxSrcset } from '../lib/photo-manifest';
import PhotoPicture from './PhotoPicture.astro';

interface Props {
  photo: AlbumPhoto;
  alt: string;
  index: number;
  total: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  photo,
  alt,
  index,
  total,
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;
const orientation = photo.image.height > photo.image.width ? 'portrait' : 'landscape';
const captionId = `photo-caption-${index + 1}`;
const photoId = photoIdFor(photo.image.sourceHash);
---

<figure class:list={['story-photo', orientation, 'rise']}>
  <a
    href={photo.image.variants.lightbox.src}
    class="zoom"
    data-lightbox
    data-photo-id={photoId}
    data-alt={alt}
    data-caption={photo.caption}
    data-srcset={lightboxSrcset(photo.image)}
    data-aspect={(photo.image.width / photo.image.height).toFixed(4)}
    aria-label={`View photograph ${index + 1} of ${total} larger`}
    aria-describedby={photo.caption ? captionId : undefined}
  >
    <PhotoPicture
      photo={photo.image}
      alt={alt}
      sizes={orientation === 'portrait'
        ? '(min-width: 900px) 720px, 94vw'
        : '(min-width: 1200px) 1040px, 94vw'}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  </a>
  {
    (photo.caption || photo.exif) && (
      <figcaption>
        {photo.caption && <p id={captionId} class="caption">{photo.caption}</p>}
        {photo.exif && (
          <details class="photo-details">
            <summary>Photo details</summary>
            <p>{photo.exif}</p>
          </details>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .story-photo {
    margin: 0;
  }

  .story-photo.portrait {
    width: min(100%, 720px);
    margin-inline: auto;
  }

  .zoom {
    display: block;
    cursor: zoom-in;
    background: var(--surface);
  }

  .story-photo :global(img) {
    width: 100%;
    border-radius: 2px;
  }

  figcaption {
    margin-top: 0.7rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.6rem 1.5rem;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .caption {
    max-width: var(--measure);
    color: color-mix(in srgb, var(--ink) 88%, var(--muted));
  }

  /* Explicit columns rather than auto-placement, so the caption and the details
     keep their sides whether or not the other is present. */
  .caption {
    grid-column: 1;
  }

  .photo-details {
    grid-column: 2;
    color: var(--muted);
    text-align: right;
  }

  .photo-details summary {
    cursor: pointer;
    white-space: nowrap;
  }

  .photo-details p {
    margin-top: 0.35rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    figcaption {
      grid-template-columns: 1fr;
    }

    .caption,
    .photo-details {
      grid-column: 1;
    }

    .photo-details {
      text-align: left;
    }
  }
</style>
