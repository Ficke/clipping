node_modules/
dist/
.astro/

# Bundled commerce Lambda. Rebuilt by `bun run lambda:build`, which
# `terraform apply` needs to have run first — see README.
dist-lambda/
.DS_Store
*.log

# Photo originals live in S3 (adamficke-com-originals), not git. Album
# markdown and generated photos.json manifests stay in git.
content/albums/**/*.jpg
content/albums/**/*.jpeg
content/albums/**/*.png
content/albums/**/*.webp
content/albums/**/*.avif

# Locally-built derivative images (served from S3/CloudFront in production;
# generated on demand for `bun run dev` by scripts/photos-media-dev.mjs)
public/media/

# Terraform (the .terraform.lock.hcl provider lockfile IS committed)
infra/.terraform/
infra/*.tfstate*
infra/tfplan*

# Preview-check screenshots.
.claude/skills/preview-check/shots/

# Per-machine Claude Code permissions are not shared.
.claude/settings.local.json

# No Stripe key should ever be stored here. Local development reads the
# adamficke-com-commerce-test parameter from SSM, so nothing is written to disk.
.env
.env.local
